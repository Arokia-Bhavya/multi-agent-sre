# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real API keys.

# --- LLM provider (Milestone 4 coordinator) ---------------------------------
# "anthropic" (default) or "groq" (has a free tier, good for trying things out)
LLM_PROVIDER=groq

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: override the default model for whichever provider is selected
# above (defaults: claude-sonnet-5 for anthropic, llama-3.3-70b-versatile
# for groq; llama-3.1-8b-instant is a faster/lighter Groq option).
LLM_MODEL=llama-3.1-8b-instant

# Optional: override the model used ONLY for the SRE Copilot's own
# conversational tool-routing loop (ai_platform/copilot/agent.py) — kept
# deliberately separate from LLM_MODEL above, which the RCA/runbook
# reasoning (ai_platform/coordinator/) still uses. Tool-routing is the
# highest-volume LLM call site in the platform (every tool round-trip, every
# turn) and a task smaller/cheaper models handle well, so the copilot
# defaults to a lighter model per provider (llama-3.1-8b-instant for groq,
# claude-haiku-4-5 for anthropic) even if LLM_MODEL above points at a
# stronger one — no separate COPILOT_LLM_PROVIDER exists on purpose, the
# copilot always uses the same provider as LLM_PROVIDER, just a lighter
# model, so it never needs a second set of credentials. Uncomment only to
# override that default further.
# COPILOT_LLM_MODEL=llama-3.1-8b-instant

# Optional: the copilot also binds a reduced ~13-tool subset by default
# (CORE_COPILOT_TOOL_NAMES in agent.py) instead of the full 20, to cut the
# fixed per-request overhead a small-TPM cheap-tier model has to fit
# conversation history into. Set to re-bind all 20 tools instead (e.g. if
# you've moved the cheap tier to a higher-TPM model/provider and don't need
# the tradeoff).
# COPILOT_FULL_TOOLS=true

# Optional: point `ai_platform/evals/` at different provider/models than
# the ones above, so eval runs draw from separate quota buckets instead of
# competing with interactive chat.py/server.py usage for the same daily
# limit (Groq's free tier caps tokens/day per model). Unset by default —
# evals fall back to LLM_PROVIDER/LLM_MODEL/COPILOT_LLM_MODEL above.
# Tier-aware: EVAL_LLM_MODEL only affects run_rca_evals.py/
# run_runbook_evals.py (the strong tier); EVAL_COPILOT_LLM_MODEL only
# affects run_tool_use_evals.py (the cheap tier) — see
# ai_platform/evals/eval_env.py.
# EVAL_LLM_PROVIDER=groq
# EVAL_LLM_MODEL=llama-3.3-70b-versatile
# EVAL_COPILOT_LLM_MODEL=llama-3.1-8b-instant

# --- Embeddings (Milestone 6 semantic search / knowledge base) -------------
# Optional. Neither LLM_PROVIDER above (anthropic/groq) exposes an
# embeddings API, so search_similar_incidents and search_knowledge_base
# (ai_platform/tools/semantic_search.py) fall back to TF-IDF
# keyword/phrase-overlap search without this. Set a Voyage AI key
# (https://www.voyageai.com/, has a free tier) to upgrade both to true
# semantic similarity instead.
VOYAGE_API_KEY=

# Optional: override the embeddings model (default: voyage-3.5-lite).
# VOYAGE_EMBED_MODEL=voyage-3.5-lite

# --- Cluster access (Milestones 2-4 clients/agents/coordinator) ------------
# These assume you've port-forwarded Prometheus and Jaeger locally, e.g.:
#   kubectl port-forward -n otel-demo svc/<prometheus-service> 9090:9090
#   kubectl port-forward -n otel-demo svc/<jaeger-service> 16686:16686
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
KUBERNETES_NAMESPACE=otel-demo

# --- Remediation guardrails (Milestone 5 copilot_tools.py) ------------------
# Hard bounds on the copilot's one cluster-mutating tool
# (remediate_scale_deployment), enforced before a human ever sees the
# approval prompt.
# Max replica count any single remediation may request.
REMEDIATION_MAX_REPLICAS=10
# Minimum seconds between two *applied* remediations against the same service.
REMEDIATION_COOLDOWN_SECONDS=300

# --- Web UI human auth: Google OIDC (Milestone 6 webui/server.py) ----------
# Every human-facing route (the "/" SPA shell and every /api/* route except
# the Alertmanager webhook below) now requires signing in with a Google
# account instead of a shared secret. To set this up:
#   1. In Google Cloud Console, create an OAuth 2.0 Client ID
#      (APIs & Services > Credentials > Create Credentials > OAuth client ID,
#      application type "Web application").
#   2. Add an Authorized redirect URI matching where you'll run this:
#      http://localhost:8000/auth/callback for local dev, or
#      https://<your-domain>/auth/callback in production.
#   3. Copy the generated client ID/secret below.
# If these are left unset, /login and /auth/login return 503 and the UI is
# unusable from a browser (the Alertmanager webhook still works via
# WEBUI_API_KEY below, since it's a separate, non-interactive auth path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorization on top of authentication: without either of these set, any
# Google account can sign in (a real verified identity, just no allowlist).
# Set one or both to restrict access to this deployment.
# Comma-separated list of exact emails allowed to sign in, e.g.:
# ALLOWED_GOOGLE_EMAILS=alice@example.com,bob@example.com
ALLOWED_GOOGLE_EMAILS=
# Restrict sign-in to a single Google Workspace domain, e.g. example.com
ALLOWED_GOOGLE_DOMAIN=

# Secret used to sign the session cookie set after a successful Google
# sign-in. Leave unset for a random one generated per process (existing
# sessions just get invalidated on restart, not a security problem) or set
# a stable value here for sessions that survive restarts (generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))").
# SESSION_SECRET_KEY=

# Set to "true" once this is served over HTTPS (e.g. behind a reverse proxy)
# so the session cookie gets the Secure flag. Leave "false"/unset for plain
# http://localhost development — browsers refuse Secure cookies over http.
WEBUI_COOKIE_SECURE=false

# --- Web UI machine auth: Alertmanager webhook only -------------------------
# Alertmanager's webhook_config POST can't complete a Google OAuth redirect
# (it's not a browser), so it keeps the original shared-secret model via a
# Bearer token or X-API-Key header on just this one endpoint
# (/api/webhook/alertmanager) — every other route uses Google sign-in above.
# Leave this line commented/unset and server.py will auto-generate a random
# key at startup and print it once. Set a value here for a stable key that
# survives restarts (generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))").
# Set WEBUI_API_KEY= (empty) to explicitly disable webhook auth — not
# recommended beyond a loopback-only setup.
# WEBUI_API_KEY=

# Host the web UI binds to. Defaults to 127.0.0.1 (localhost-only) even
# without this var set. Only set to 0.0.0.0 (or a specific LAN IP)
# deliberately, and pair it with WEBUI_COOKIE_SECURE=true behind a
# TLS-terminating proxy — if Alertmanager runs elsewhere (e.g. in the Kind
# cluster) and needs to reach this webhook, configure its webhook receiver
# to send the same X-API-Key/Bearer header rather than leaving it open.
WEBUI_HOST=127.0.0.1

# Max number of alert investigations (auto_responder.py) that run
# concurrently. Each one is several LLM + Prometheus/Jaeger/K8s round
# trips; without this cap, a cascade of alerts firing together (the normal
# shape of a real outage) would fire that many concurrent investigations
# at once. Extra incidents past this limit show status "queued" in the
# Incidents panel rather than starting immediately.
MAX_CONCURRENT_INVESTIGATIONS=3
