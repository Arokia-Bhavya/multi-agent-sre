# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real API keys.

# --- LLM provider (Milestone 4 coordinator) ---------------------------------
# "anthropic" (default) or "groq" (has a free tier, good for trying things out)
LLM_PROVIDER=groq

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: override the default model for whichever provider is selected
# above (defaults: claude-sonnet-5 for anthropic, llama-3.3-70b-versatile
# for groq; llama-3.1-8b-instant is a faster/lighter Groq option).
LLM_MODEL=llama-3.1-8b-instant

# --- Cluster access (Milestones 2-4 clients/agents/coordinator) ------------
# These assume you've port-forwarded Prometheus and Jaeger locally, e.g.:
#   kubectl port-forward -n otel-demo svc/<prometheus-service> 9090:9090
#   kubectl port-forward -n otel-demo svc/<jaeger-service> 16686:16686
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
KUBERNETES_NAMESPACE=otel-demo
